---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Experience from '../components/Experience.astro';
import Stack from '../components/Stack.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
  <Header />
  <main id="main" tabindex="-1">

    <Hero />

    <!-- Proyectos -->
    <section id="proyectos" class="section-py bg-bg-subtle" aria-labelledby="proyectos-heading">
      <div class="container">
        <div class="mb-12" data-scroll-fade>
          <h2 id="proyectos-heading" class="mb-3">Proyectos</h2>
          <p class="text-text-muted max-w-[52ch]">
            Proyectos reales en producción con contexto de negocio y métricas de performance.
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" data-scroll-stagger>
          {projects.filter(p => p.featured).map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>

    <Experience />
    <Stack />
    <Contact />

  </main>
  <Footer />
</BaseLayout>
