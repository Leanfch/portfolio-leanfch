---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Experience from '../../components/Experience.astro';
import Stack from '../../components/Stack.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../i18n/translations';
import { projects } from '../../data/projects';

const lang = 'en' as const;
const t = ui[lang];
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} t={t.nav} />
  <main id="main" tabindex="-1">

    <Hero t={t.hero} />

    <section id="projects" class="section-py bg-bg-subtle" aria-labelledby="projects-heading">
      <div class="container">
        <div class="mb-12" data-scroll-fade>
          <h2 id="projects-heading" class="mb-3">{t.projects.heading}</h2>
          <p class="text-text-muted max-w-[52ch]">{t.projects.sub}</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" data-scroll-stagger>
          {projects.filter(p => p.featured).map((project) => (
            <ProjectCard project={project} lang={lang} t={t.projects} tCase={t.caseStudy} />
          ))}
        </div>
      </div>
    </section>

    <Experience lang={lang} t={t.experience} />
    <Stack t={t.stack} />
    <Contact t={t.contact} />

  </main>
  <Footer t={t.footer} />
</BaseLayout>
