---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section
  id={`case-${project.id}`}
  class="hidden border-t border-border bg-bg-subtle"
  role="region"
  aria-label={`Caso de estudio: ${project.title}`}
>
  <div class="p-6">

    <p class="font-mono text-xs uppercase tracking-widest text-accent mb-6">
      Caso de estudio
    </p>

    <!-- Contexto + Mi rol -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">
          Contexto
        </h4>
        <p class="text-sm text-text leading-relaxed">{project.description}</p>
        <p class="text-sm text-text-muted mt-2">
          <span class="text-text-muted/60">Cliente:</span> {project.client}
        </p>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">
          Mi rol
        </h4>
        <p class="text-sm text-text leading-relaxed">{project.myRole}</p>
      </div>
    </div>

    <!-- Stack técnico -->
    <div class="mb-6">
      <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">
        Stack técnico
      </h4>
      <div class="flex flex-wrap gap-2">
        {project.stack.map(tech => (
          <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-bg-card border border-border text-text-muted">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- Métricas -->
    {project.metrics && project.metrics.length > 0 && (
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">
          Resultados
        </h4>
        <div class="flex flex-wrap gap-3">
          {project.metrics.map(metric => (
            <div class="bg-bg-card border border-border rounded-lg px-5 py-4 min-w-[120px]">
              <div class="font-mono text-2xl font-bold text-accent">{metric.value}</div>
              <div class="text-xs text-text-muted mt-1">{metric.label}</div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>
