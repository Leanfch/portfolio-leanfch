---
import type { Lang, UI } from '../i18n/translations';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
  t: UI['caseStudy'];
}

const { project, lang, t } = Astro.props;
---

<section
  id={`case-${project.id}`}
  class="hidden border-t border-border bg-bg-subtle"
  role="region"
  aria-label={`${t.label}: ${project.title}`}
>
  <div class="p-6">

    <p class="font-mono text-xs uppercase tracking-widest text-accent mb-6">
      {t.label}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">
          {t.context}
        </h4>
        <p class="text-sm text-text leading-relaxed">{project.description[lang]}</p>
        <p class="text-sm text-text-muted mt-2">
          <span class="text-text-muted/60">{t.client}:</span> {project.client}
        </p>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">
          {t.role}
        </h4>
        <p class="text-sm text-text leading-relaxed">{project.myRole[lang]}</p>
      </div>
    </div>

    <div class="mb-6">
      <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">
        {t.stack}
      </h4>
      <div class="flex flex-wrap gap-2">
        {project.stack.map(tech => (
          <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-bg-card border border-border text-text-muted">
            {tech}
          </span>
        ))}
      </div>
    </div>

    {project.metrics && project.metrics.length > 0 && (
      <div>
        <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">
          {t.results}
        </h4>
        <div class="flex flex-wrap gap-3">
          {project.metrics.map(metric => (
            <div class="bg-bg-card border border-border rounded-lg px-5 py-4 min-w-[120px]">
              <div class="font-mono text-2xl font-bold text-accent">{metric.value}</div>
              <div class="text-xs text-text-muted mt-1">{metric.label[lang]}</div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>
