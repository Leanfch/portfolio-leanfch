---
import type { Lang, UI } from '../i18n/translations';
import { experience } from '../data/experience';

interface Props {
  lang: Lang;
  t: UI['experience'];
}

const { lang, t } = Astro.props;
---

<section id="experience" class="section-py" aria-labelledby="experience-heading">
  <div class="container">

    <div class="mb-10" data-scroll-fade>
      <h2 id="experience-heading" class="mb-3">{t.heading}</h2>
      <p class="text-text-muted max-w-[50ch]">{t.sub}</p>
    </div>

    <div class="space-y-1" data-scroll-stagger>
      {experience.map(item => (
        <article
          class="group flex flex-col sm:flex-row gap-3 sm:gap-8
                 px-5 py-5 rounded-xl border border-transparent
                 hover:bg-bg-subtle hover:border-border/50
                 transition-all duration-200 cursor-default"
          data-stagger-item
        >
          <div class="sm:w-44 shrink-0 sm:pt-0.5">
            <p class="font-mono text-xs text-text-muted tracking-wide whitespace-nowrap">
              {item.period}
            </p>
          </div>

          <div class="flex-1 min-w-0">

            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-3">
              <p class="text-base font-semibold text-text leading-snug">{item.role[lang]}</p>
              <span class="text-border" aria-hidden="true">·</span>
              {item.companyUrl ? (
                <a
                  href={item.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-accent hover:underline font-medium"
                >
                  {item.company}
                  <span aria-hidden="true" class="text-xs ml-0.5 opacity-70">↗</span>
                </a>
              ) : (
                <span class="text-sm text-text-muted font-medium">{item.company}</span>
              )}
            </div>

            <ul class="space-y-1.5 mb-4" role="list">
              {item.description[lang].map(bullet => (
                <li class="flex gap-2.5 text-sm text-text-muted leading-relaxed">
                  <span class="text-accent/50 shrink-0 mt-[5px] text-[9px]" aria-hidden="true">▸</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-1.5" aria-label="Stack">
              {item.tags.map(tag => (
                <span class="font-mono text-xs px-2 py-0.5 rounded
                             bg-accent-soft/30 border border-accent/20 text-accent">
                  {tag}
                </span>
              ))}
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>
