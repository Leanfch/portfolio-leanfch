---
import type { Lang, UI } from '../i18n/translations';
import type { Project } from '../data/projects';
import CaseStudy from './CaseStudy.astro';

interface Props {
  project: Project;
  lang: Lang;
  t: UI['projects'];
  tCase: UI['caseStudy'];
}

const { project, lang, t, tCase } = Astro.props;
---

<article
  class="flex flex-col rounded-xl border border-border bg-bg-card overflow-hidden
         hover:border-accent/30 hover:-translate-y-1 transition-all duration-300"
  data-project-id={project.id}
  data-stagger-item
>
  <div class="aspect-video bg-bg-subtle overflow-hidden">
    <img
      src={project.coverImage}
      alt={`Screenshot — ${project.title}`}
      class="w-full h-full object-cover"
      loading="lazy"
      width="800"
      height="450"
    />
  </div>

  <div class="flex flex-col flex-1 p-6 gap-4">

    <span class="self-start font-mono text-xs px-2.5 py-1 rounded-full
                 bg-accent-soft/40 border border-accent/20 text-accent">
      {t.types[project.type] ?? project.type}
    </span>

    <div>
      <h3 class="text-xl font-bold mb-1.5">{project.title}</h3>
      <p class="text-sm text-text-muted leading-relaxed">{project.description[lang]}</p>
    </div>

    <div class="flex flex-wrap gap-1.5" aria-label="Stack">
      {project.stack.map(tech => (
        <span class="font-mono text-xs px-2 py-0.5 rounded bg-bg-subtle border border-border text-text-muted">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex gap-3 mt-auto pt-2">
      <button
        class="text-sm font-medium px-4 py-2 rounded-lg border border-border text-text-muted
               hover:text-text hover:border-text-muted/40 transition-all duration-200"
        aria-expanded="false"
        aria-controls={`case-${project.id}`}
        data-toggle-case
        data-label-open={t.viewCase}
        data-label-close={t.closeCase}
      >
        {t.viewCase}
      </button>
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg
                 text-accent hover:bg-accent-soft/30 transition-all duration-200"
          aria-label={`${t.viewSite} — ${project.title}`}
        >
          {t.viewSite}
          <span aria-hidden="true" class="text-xs">↗</span>
        </a>
      )}
    </div>

  </div>

  <CaseStudy project={project} lang={lang} t={tCase} />
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-case]').forEach(button => {
    button.addEventListener('click', () => {
      const caseId = button.getAttribute('aria-controls');
      const caseStudy = caseId ? document.getElementById(caseId) : null;
      if (!caseStudy) return;

      const willOpen = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(willOpen));
      button.textContent = willOpen
        ? (button.dataset.labelClose ?? 'Close')
        : (button.dataset.labelOpen  ?? 'View');
      caseStudy.classList.toggle('hidden', !willOpen);
    });
  });
</script>
