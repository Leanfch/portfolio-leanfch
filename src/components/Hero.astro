---
---

<section class="relative overflow-hidden min-h-screen flex items-center pt-16">

  <!-- Decorative gradient — muy sutil, no distrae -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 0% 25%, rgba(79,126,247,0.07) 0%, transparent 55%);"
    aria-hidden="true"
  ></div>

  <div class="container relative py-20 sm:py-28">

    <!-- Badge de disponibilidad -->
    <div class="inline-flex items-center gap-2 rounded-full border border-border bg-bg-card px-3 py-1.5 mb-10" data-hero-badge>
      <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
      </span>
      <span class="font-mono text-xs text-text-muted">Disponible para nuevos proyectos</span>
    </div>

    <!-- Headline -->
    <h1 class="font-extrabold mb-6 max-w-[18ch] leading-[1.08] tracking-tight" data-hero-title>
      Desarrollo landing pages que convierten.
    </h1>

    <!-- Subheadline -->
    <p class="text-xl text-text-muted max-w-[44ch] mb-10 leading-relaxed" data-hero-sub>
      Full-Stack Developer especializado en UI, performance y SEO técnico.{' '}
      <span class="text-text-muted/60">Buenos Aires, Argentina.</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-3" data-hero-ctas>
      <a
        href="#proyectos"
        class="inline-flex items-center px-6 py-3 rounded-lg bg-accent text-white text-sm font-semibold
               hover:-translate-y-0.5 hover:bg-accent/90 active:translate-y-0
               transition-all duration-200"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border
               text-text-muted text-sm font-medium
               hover:text-text hover:border-text-muted/30
               transition-all duration-200"
      >
        Contactar
        <span aria-hidden="true" class="text-base leading-none">→</span>
      </a>
    </div>

  </div>
</section>
